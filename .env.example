# ==================== NoneBot 基础配置 ====================
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080
SUPERUSERS=[]
NICKNAME=["鲸娘"]

# ==================== NapCat (OneBot 11) 连接配置 ====================
# 方式一：正向 WebSocket（推荐）。NapCat 中开启"正向 WebSocket 服务器"，默认端口 3001
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# 方式二：反向 WebSocket。如需使用，注释掉上面一行，改用下面两行，
#         并在 NapCat 中新建"反向 WebSocket"客户端连接 ws://127.0.0.1:8080
# ONEBOT_WS_REVERSE_HOST=127.0.0.1
# ONEBOT_WS_REVERSE_PORT=8080

# ==================== AI 智能体（OpenAI 兼容接口）====================
# AI_ENABLED=true 后，机器人自动进入"鲸娘"智能体模式（所有 @/私聊 消息交给 AI）
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash
# 消息含图片时自动切换的视觉模型（需支持图片输入）
AI_VISION_MODEL=GLM-4V-Plus-0111
# -q 答题模式专用模型，留空则用 AI_MODEL
# AI_QA_MODEL=
# AI_MAX_HISTORY=20
# AI_COOLDOWN=3.0
# 每次 AI 回复随机附带一张表情包的概率（默认 0.125，即 1/8；用户明确索要表情时必发）
# STICKER_PROB=0.125

# ==================== 对话模型渠道（/切换人格 -grok / -astra）====================
# 在群/私聊里用 /切换人格 -grok 或 /切换人格 -astra 可把该会话的对话模型切到对应渠道
# 两个渠道均走 moyuu 的 OpenAI 兼容接口，需分别填写 Key 才会生效
# GROK_API_KEY=
# GROK_BASE_URL=https://moyuu.cc/v1
# GROK_MODEL=grok-4.6
# ASTRA_API_KEY=
# ASTRA_BASE_URL=https://moyuu.cc/v1
# ASTRA_MODEL=gpt-6-astra

# ==================== 生图渠道（moyuu）====================
# 默认通道走 moyuu 的 gpt-image-2-web（对应 /生图 的 -web 参数）
# MOYUU_API_KEY=
# MOYUU_BASE_URL=https://moyuu.cc/v1
# IMAGE_MODEL=gpt-image-2-web
# 默认通道连不上时依次轮询的兜底模型（英文逗号分隔）
# IMAGE_FALLBACK_MODELS=gpt-image-2,gpt-image-2-ad-medium,gpt-image-2-ad-medium2,gpt-image-2.5-flare,gpt-image-2.5-sunburst
# IMAGE_SIZE=1024x1024

# ==================== 联网搜索（博查 Bocha）====================
# 填写后 AI 遇到不懂/拿不准/需实时信息的问题会自动上网搜索再作答（全局生效，不受群白名单约束）
# 申请 Key：https://open.bochaai.com/   留空则关闭联网搜索能力
# BOCHA_API_KEY=
# 每次搜索返回的结果条数（1~10，默认 5）
# BOCHA_SEARCH_COUNT=5

# ==================== 隐私脱敏配置（原硬编码的 QQ 号/群号/地址迁到此处）====================
# 根管理员 QQ（超管，种子 OP，永远有效）
# ROOT_SEED=
# 旧白名单管控群（该群首次接入时按 /白名单 建档；0=不启用旧群自动建档）
# RESTRICT_GROUP=0
# /查看撤回 仅根管理员可用的群（JSON 数组）
# ROOT_ONLY_GROUPS=[]
# 网站镜像服务的公网入口地址（/镜像 返回的访问地址前缀）
# MIRROR_BASE=
