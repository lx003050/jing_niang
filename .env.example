# ==================== NoneBot 基础配置 ====================
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080
SUPERUSERS=[]
NICKNAME=["分院帽"]

# ==================== NapCat (OneBot 11) 连接配置 ====================
# 方式一：正向 WebSocket（推荐）。NapCat 中开启"正向 WebSocket 服务器"，默认端口 3001
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# 方式二：反向 WebSocket。如需使用，注释掉上面一行，改用下面两行，
#         并在 NapCat 中新建"反向 WebSocket"客户端连接 ws://127.0.0.1:8080
# ONEBOT_WS_REVERSE_HOST=127.0.0.1
# ONEBOT_WS_REVERSE_PORT=8080

# ==================== AI 智能体（OpenAI 兼容接口）====================
# AI_ENABLED=true 后，机器人自动进入"分院帽"智能体模式（所有 @/私聊 消息交给 AI）
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash
# 消息含图片时自动切换的视觉模型（需支持图片输入）
AI_VISION_MODEL=GLM-4V-Plus-0111
# -q 答题模式专用模型，留空则用 AI_MODEL
# AI_QA_MODEL=
# AI_MAX_HISTORY=20
# AI_COOLDOWN=3.0

# ==================== 隐私脱敏配置（原硬编码的 QQ 号/群号/地址迁到此处）====================
# 根管理员 QQ（超管，种子 OP，永远有效）
# ROOT_SEED=
# 旧白名单管控群（该群首次接入时按 /白名单 建档；0=不启用旧群自动建档）
# RESTRICT_GROUP=0
# /查看撤回 仅根管理员可用的群（JSON 数组）
# ROOT_ONLY_GROUPS=[]
# 网站镜像服务的公网入口地址（/镜像 返回的访问地址前缀）
# MIRROR_BASE=
